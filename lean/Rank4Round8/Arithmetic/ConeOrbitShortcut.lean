import Rank4Round5.Verification.UnboundedAcyclicDepth
import Rank4Round3.MutationSignPullback
import Mathlib.Data.Nat.Log

/-!
An arithmetic fast path for the MA cone orbit used to prove unbounded shortest
acyclic mutation depth. The candidate states are generated by a three-integer
linear recurrence, with no mutation evaluation. The input height bounds the
number of recurrence steps logarithmically.
-/

namespace Rank4Round8.Arithmetic

open QuiverProofs Rank4Formula Rank4Round3 Rank4Round5.Verification

def coneArithmeticSeed : Cone.State := ⟨1, 0, 1⟩

def coneArithmeticState (n : Nat) : Cone.State :=
  Cone.orbit 2 1 1 coneArithmeticSeed n

def coneArithmeticTuple (n : Nat) : SixTuple :=
  upperTuple (Cone.quiver 2 1 1 (coneArithmeticState n))

theorem coneArithmeticTuple_coord_two (n : Nat) :
    coneArithmeticTuple n 2 = (coneArithmeticState n).A := by
  rfl

theorem coneArithmeticTuple_fixed (n : Nat) :
    coneArithmeticTuple n 0 = -2 ∧
    coneArithmeticTuple n 1 = -1 ∧
    coneArithmeticTuple n 3 = -1 := by
  simp [coneArithmeticTuple, Cone.quiver, upperTuple, upperEntry, ofSix]

theorem coneArithmeticTuple_descendant (n : Nat) :
    ofTuple (coneArithmeticTuple n) = coneDescendant n := by
  have hs : SkewSymmetric (Cone.quiver 2 1 1 (coneArithmeticState n)) := by
    simpa [Cone.quiver] using
      ofSix_skew (-2) (-1) (coneArithmeticState n).A (-1)
        (coneArithmeticState n).H (-(coneArithmeticState n).Z)
  rw [coneArithmeticTuple, ofTuple_upperTuple _ hs]
  simpa [coneDescendant, coneSeed, coneArithmeticState,
    coneArithmeticSeed] using
    (Cone.orbit_as_mutations 2 1 1 (⟨1, 0, 1⟩ : Cone.State)
      (by decide) (by decide) (by decide)
      (by norm_num [Cone.InCone]) n).symm

theorem coneArithmeticTuple_MA (n : Nat) :
    MutationAcyclic (ofTuple (coneArithmeticTuple n)) := by
  rw [coneArithmeticTuple_descendant]
  exact coneDescendant_MA n

theorem coneArithmetic_A_ge_pow (n : Nat) :
    ((2 : Nat) ^ n : Int) ≤ (coneArithmeticState n).A := by
  induction n with
  | zero => simp [coneArithmeticState, Cone.orbit, coneArithmeticSeed]
  | succ n ih =>
      have hc : Cone.InCone 1 (coneArithmeticState n).A
          (coneArithmeticState n).H (coneArithmeticState n).Z := by
        exact Cone.orbit_in_cone 2 1 1 coneArithmeticSeed
          (by decide) (by decide) (by decide)
          (by norm_num [Cone.InCone, coneArithmeticSeed]) n
      have hd : 2 * (coneArithmeticState n).A ≤
          (coneArithmeticState (n + 1)).A := by
        simpa [coneArithmeticState, Cone.orbit, Cone.step] using
          (Cone.doubles_A 2 1 1 (coneArithmeticState n).A
            (coneArithmeticState n).H (coneArithmeticState n).Z
            (by decide) (by decide) (by decide) hc (by decide))
      have hp : ((2 : Nat) ^ (n + 1) : Int) =
          2 * ((2 : Nat) ^ n : Int) := by
        simp [pow_succ, mul_comm]
      rw [hp]
      exact le_trans (mul_le_mul_of_nonneg_left ih (by norm_num)) hd

theorem coneArithmetic_index_le_log2 (n : Nat) :
    n ≤ Nat.log2 ((coneArithmeticTuple n 2).toNat) := by
  have hp := coneArithmetic_A_ge_pow n
  rw [coneArithmeticTuple_coord_two] at *
  have hn : 0 < (coneArithmeticState n).A := by
    have hpow : (0 : Int) < ((2 : Nat) ^ n : Int) := by exact_mod_cast pow_pos (by norm_num : 0 < (2 : Nat)) n
    omega
  have hpNat : 2 ^ n ≤ ((coneArithmeticState n).A).toNat := by
    have hA : 0 ≤ (coneArithmeticState n).A := by omega
    rw [← Int.toNat_of_nonneg hA] at hp
    exact_mod_cast hp
  exact (Nat.le_log2 (by omega : ((coneArithmeticState n).A).toNat ≠ 0)).mpr hpNat

/-- A decidable membership test in the arithmetic recurrence orbit.
    Every generated candidate uses only integer arithmetic. -/
def coneOrbitShortcut (q : SixTuple) : Option Bool :=
  if q 0 = -2 ∧ q 1 = -1 ∧ q 3 = -1 then
    if q ∈ (List.range (Nat.log2 (q 2).toNat + 1)).map coneArithmeticTuple then
      some true
    else none
  else none

theorem coneOrbitShortcut_spec (q : SixTuple) (b : Bool)
    (h : coneOrbitShortcut q = some b) :
    b = true ↔ MutationAcyclic (ofTuple q) := by
  unfold coneOrbitShortcut at h
  split at h
  · split at h
    · rename_i hm
      have hb : b = true := by simpa using h.symm
      have hmember : ∃ n, q = coneArithmeticTuple n := by
        obtain ⟨n, _, rfl⟩ := List.mem_map.mp hm
        exact ⟨n, rfl⟩
      obtain ⟨n, rfl⟩ := hmember
      simp [hb, coneArithmeticTuple_MA]
    · simp at h
  · simp at h

theorem coneOrbitShortcut_complete (n : Nat) :
    coneOrbitShortcut (coneArithmeticTuple n) = some true := by
  have hb := coneArithmetic_index_le_log2 n
  have hm : n ∈ List.range (Nat.log2 (coneArithmeticTuple n 2).toNat + 1) := by
    simpa only [List.mem_range] using Nat.lt_succ_of_le hb
  have hlist : coneArithmeticTuple n ∈
      (List.range (Nat.log2 (coneArithmeticTuple n 2).toNat + 1)).map
        coneArithmeticTuple := List.mem_map.mpr ⟨n, hm, rfl⟩
  simp [coneOrbitShortcut, coneArithmeticTuple_fixed, hlist]

/-- The direct arithmetic shortcut recognizes MA inputs whose shortest
    acyclic mutation words exceed any prescribed constant depth. -/
theorem coneOrbitShortcut_unbounded_acyclic_depth (r : Nat) :
    ∃ q : SixTuple, coneOrbitShortcut q = some true ∧
      ∀ w : List (Fin 4), w.length ≤ r →
        ¬ Acyclic (applyWord (ofTuple q) w) := by
  obtain ⟨n, hn⟩ := no_short_acyclic_word r
  refine ⟨coneArithmeticTuple n, coneOrbitShortcut_complete n, ?_⟩
  simpa only [coneArithmeticTuple_descendant] using hn

