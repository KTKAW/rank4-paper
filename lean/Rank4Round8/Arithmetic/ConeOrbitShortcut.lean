#print axioms coneArithmeticTuple_MA
#print axioms coneArithmetic_A_ge_pow
#print axioms coneArithmetic_index_le_log2
#print axioms coneOrbitShortcut_spec
#print axioms coneOrbitShortcut_complete
#print axioms coneOrbitShortcut_unbounded_acyclic_depth

end Rank4Round8.Arithmetic
