import QuiverProofs.CensusData

set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace QuiverProofs.Census

def BoundedTwo (B : Matrix 4) : Prop := ∀ i j, -2 ≤ B i j ∧ B i j ≤ 2
instance (B : Matrix 4) : Decidable (BoundedTwo B) := by unfold BoundedTwo; infer_instance

def BoundedRun (B : Matrix 4) : List (Fin 4) → Prop
  | [] => BoundedTwo B
  | k :: ks => BoundedTwo B ∧ BoundedRun (mutate B k) ks

def boundedRunDecidable (B : Matrix 4) : (word : List (Fin 4)) → Decidable (BoundedRun B word)
  | [] => inferInstanceAs (Decidable (BoundedTwo B))
  | k :: ks =>
    match (inferInstance : Decidable (BoundedTwo B)), boundedRunDecidable (mutate B k) ks with
    | .isTrue hB, .isTrue hR => .isTrue ⟨hB,hR⟩
    | .isFalse hB, _ => .isFalse (fun h => hB h.1)
    | _, .isFalse hR => .isFalse (fun h => hR h.2)

instance (B : Matrix 4) (word : List (Fin 4)) : Decidable (BoundedRun B word) :=
  boundedRunDecidable B word

