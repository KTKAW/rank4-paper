def maRepresentative (i : Fin 561) : Matrix 4 := rawRepresentative (maRepCodes.get i.val)
def maWord (i : Fin 561) : List (Fin 4) := maWords.get i.val
def maRank (i : Fin 561) (v : Fin 4) : Nat := (digit4 (maRanks.get i.val) v).val

theorem ma_source_indices : ∀ i : Fin 561, maRepCodes.get i.val < 695 := by decide
theorem ma_adjacent_indices : ∀ i : Fin 560,
    maRepCodes.get i.val < maRepCodes.get (i.val+1) := by decide
theorem ma_word_lengths : ∀ i : Fin 561, (maWord i).length ≤ 3 := by decide
theorem ma_runs_bounded : ∀ i : Fin 561, BoundedRun (maRepresentative i) (maWord i) := by decide
theorem ma_endpoint_rankings : ∀ (i : Fin 561) (u v : Fin 4),
    0 < applyWord (maRepresentative i) (maWord i) u v → maRank i u < maRank i v := by decide

/-- One uniform theorem over all 561 supplied MA representatives, including
every intermediate matrix and the acyclic terminal matrix. -/
theorem all_ma_short_bounded (i : Fin 561) :
    ∃ word : List (Fin 4), word.length ≤ 3 ∧
      BoundedRun (maRepresentative i) word ∧ Acyclic (applyWord (maRepresentative i) word) := by
  exact ⟨maWord i, ma_word_lengths i, ma_runs_bounded i, maRank i, ma_endpoint_rankings i⟩

end QuiverProofs.Census
