theorem tags_bounded : ∀ r : Fin 695, tags.get r.val < 695 := by decide +kernel

def tag (r : Fin 695) : Nat := tags.get r.val

def negativeRepresentative (i : Fin 134) : Matrix 4 := rawRepresentative (negativeCodes.get i.val)

def positiveIndex (r : Fin 695) (h : tag r < 561) : Fin 561 := ⟨tag r,h⟩
def negativeIndex (r : Fin 695) (h : ¬tag r < 561) : Fin 134 :=
  ⟨tag r - 561, by have := tags_bounded r; change tag r < 695 at this; omega⟩

theorem positive_lookup : ∀ (r : Fin 695), ∀ h : tag r < 561, ∀ u v,
    representative r u v = maRepresentative (positiveIndex r h) u v := by decide +kernel

