def connectionRepresentative (i : Fin 695) : Matrix 4 :=
  rawRepresentative (connectionCodes.get i.val)

theorem connection_code_bounds : ∀ i : Fin 695,
    connectionCodes.get i.val < 695 := by decide
theorem connection_inverse_bounds : ∀ i : Fin 695,
    connectionInverse.get i.val < 695 := by decide
theorem connection_inverse_left : ∀ i : Fin 695,
    connectionInverse.get (connectionCodes.get i.val) = i.val := by decide
theorem connection_inverse_right : ∀ i : Fin 695,
    connectionCodes.get (connectionInverse.get i.val) = i.val := by decide

/-- Exactly the first 667 entries are connected; the remaining 28 are not.
The inverse tables above prove this is a permutation of all 695 representatives. -/
theorem connectivity_partition : ∀ i : Fin 695,
    ConnectedSupport (connectionRepresentative i) ↔ i.val < 667 := by decide

end QuiverProofs.Census
