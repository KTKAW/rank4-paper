import QuiverProofs.ProperWiggleData

/-! Sound and complete wiggle-class enumeration for every skew-symmetric
integer rank-four matrix. This classifies cyclic orders only; it does not
assert mutation acyclicity or total properness. -/
set_option maxHeartbeats 3000000
set_option maxRecDepth 100000
namespace QuiverProofs.ProperWiggle
open ProperOrder Census

private theorem same_refl (p : CyclicOrder) : SameCyclicOrder p p := fun _ _ _ => Iff.rfl
private theorem same_symm {p q : CyclicOrder} (h : SameCyclicOrder p q) :
    SameCyclicOrder q p := fun u v w => (h u v w).symm
private theorem same_trans {p q r : CyclicOrder}
    (h : SameCyclicOrder p q) (g : SameCyclicOrder q r) : SameCyclicOrder p r :=
  fun u v w => (h u v w).trans (g u v w)

private theorem permutation_eq_of_toFun_eq (p q : CyclicOrder)
    (h : p.toFun=q.toFun) : p=q := by
  have hi : p.invFun=q.invFun := by
    funext i
    apply p.injective
    rw [p.right_inv,h,q.right_inv]
  cases p
  cases q
  simp_all

/-- One actual adjacent nonedge swap, allowing arbitrary rotation of its
linear representative before and after the swap. -/
def WiggleStep (B : Matrix 4) (p q : CyclicOrder) : Prop :=
  ∃ r : CyclicOrder, ∃ a : Fin 4,
    SameCyclicOrder p r ∧ B (r.toFun a) (r.toFun (nextPosition a))=0 ∧
    SameCyclicOrder (swapAdjacent r a) q

/-- The finite-path equivalence generated by rotations and adjacent nonedge
swaps. The definition has no bound on the number of swaps. -/
inductive WiggleEquivalent (B : Matrix 4) : CyclicOrder → CyclicOrder → Prop
  | same {p q} : SameCyclicOrder p q → WiggleEquivalent B p q
  | step {p q} : WiggleStep B p q → WiggleEquivalent B p q
  | trans {p q r} : WiggleEquivalent B p q → WiggleEquivalent B q r → WiggleEquivalent B p r

/-- Any swap in any of the 24 linear representatives normalizes to an edge
between the six canonical cyclic orders. -/
theorem swap_normalization (p : CyclicOrder) (a : Fin 4) : ∃ (i : Fin 6) (b : Fin 4),
    SameCyclicOrder p (order i) ∧ p.toFun a=(order i).toFun b ∧
    p.toFun (nextPosition a)=(order i).toFun (nextPosition b) ∧
    SameCyclicOrder (swapAdjacent p a) (order (neighbor i b)) := by
  obtain ⟨k,hk⟩ := permutation_exhaustive p
  have hp := permutation_eq_of_toFun_eq p (permutation k) hk
  subst p
  exact permutation_swap_normalization k a

def supportBit (x : Int) : Nat := if x=0 then 0 else 1
private theorem supportBit_le (x : Int) : supportBit x ≤ 1 := by
  unfold supportBit; split <;> omega

def supportMask (B : Matrix 4) : Fin 64 :=
  ⟨supportBit (B 0 1)+2*supportBit (B 0 2)+4*supportBit (B 0 3)+
   8*supportBit (B 1 2)+16*supportBit (B 1 3)+32*supportBit (B 2 3), by
    have := supportBit_le (B 0 1)
    have := supportBit_le (B 0 2)
    have := supportBit_le (B 0 3)
    have := supportBit_le (B 1 2)
    have := supportBit_le (B 1 3)
    have := supportBit_le (B 2 3)
    omega⟩

/-- Support masks preserve exactly the nonedges, with no entry-size bound. -/
theorem support_exact (B : Matrix 4) (hB : SkewSymmetric B) (i j : Fin 4) :
    supportMatrix (supportMask B) i j=0 ↔ B i j=0 := by
  have hi : i=0 ∨ i=1 ∨ i=2 ∨ i=3 := by omega
  have hj : j=0 ∨ j=1 ∨ j=2 ∨ j=3 := by omega
  by_cases h0 : B 0 1=0 <;> by_cases h1 : B 0 2=0 <;>
    by_cases h2 : B 0 3=0 <;> by_cases h3 : B 1 2=0 <;>
    by_cases h4 : B 1 3=0 <;> by_cases h5 : B 2 3=0 <;>
    rcases hi with rfl | rfl | rfl | rfl <;>
    rcases hj with rfl | rfl | rfl | rfl <;>
    simp [supportMatrix,supportMask,supportBit,h0,h1,h2,h3,h4,h5,ofSix] <;>
    first | (have := hB 0 0; omega) | (have := hB 1 1; omega) |
      (have := hB 2 2; omega) | (have := hB 3 3; omega) |
      (have := hB 1 0; omega) | (have := hB 2 0; omega) |
      (have := hB 3 0; omega) | (have := hB 2 1; omega) |
      (have := hB 3 1; omega) | (have := hB 3 2; omega)

theorem edge_sound (B : Matrix 4) (hB : SkewSymmetric B) (i j : Fin 6)
    (h : Edge (supportMask B) i j) : WiggleEquivalent B (order i) (order j) := by
  obtain ⟨a,ha,hj⟩ := h
  apply WiggleEquivalent.step
  refine ⟨order i,a,same_refl _,(support_exact B hB _ _).mp ha,?_⟩
  simpa only [hj] using neighbor_correct i a

theorem path_sound (B : Matrix 4) (hB : SkewSymmetric B)
    (i j : Fin 6) (path : List (Fin 6)) (h : ValidPath (supportMask B) i path j) :
    WiggleEquivalent B (order i) (order j) := by
  induction path generalizing i with
  | nil => cases h; exact .same (same_refl _)
  | cons k ks ih => exact .trans (edge_sound B hB i k h.1) (ih k h.2)

theorem step_component (B : Matrix 4) (hB : SkewSymmetric B)
    (p q : CyclicOrder) (h : WiggleStep B p q)
    (i j : Fin 6) (hi : SameCyclicOrder p (order i)) (hj : SameCyclicOrder q (order j)) :
    component (supportMask B) i=component (supportMask B) j := by
  obtain ⟨r,a,hpr,ha,hrq⟩ := h
  obtain ⟨u,b,hru,hua,hun,hswap⟩ := swap_normalization r a
  have hiu : i=u := six_orders_distinct i u (same_trans (same_symm hi) (same_trans hpr hru))
  have hju : j=neighbor u b := six_orders_distinct j (neighbor u b)
    (same_trans (same_symm hj) (same_trans (same_symm hrq) hswap))
  subst i
  subst j
  apply edge_component
  refine ⟨b,?_,rfl⟩
  apply (support_exact B hB _ _).mpr
  simpa only [hua,hun] using ha

/-- No finite wiggle path can leave its tabulated support component. -/
theorem wiggle_component (B : Matrix 4) (hB : SkewSymmetric B)
    {p q : CyclicOrder} (h : WiggleEquivalent B p q)
    (i j : Fin 6) (hi : SameCyclicOrder p (order i)) (hj : SameCyclicOrder q (order j)) :
    component (supportMask B) i=component (supportMask B) j := by
  induction h generalizing i j with
  | same h =>
    have he : i=j := six_orders_distinct i j (same_trans (same_symm hi) (same_trans h hj))
    rw [he]
  | step h => exact step_component B hB _ _ h i j hi hj
  | @trans p q r hpq hqr ih1 ih2 =>
    obtain ⟨k,hk⟩ := cyclic_order_exhaustive q
    exact (ih1 i k hi hk).trans (ih2 k j hk hj)

/-- The table computes exactly the equivalence generated by all finite
nonedge-swap sequences. It is both sound and complete, for arbitrary weights. -/
theorem wiggle_iff_component (B : Matrix 4) (hB : SkewSymmetric B)
    (p q : CyclicOrder) (i j : Fin 6)
    (hi : SameCyclicOrder p (order i)) (hj : SameCyclicOrder q (order j)) :
    WiggleEquivalent B p q ↔ component (supportMask B) i=component (supportMask B) j := by
  constructor
  · exact fun h => wiggle_component B hB h i j hi hj
  · intro h
    exact .trans (.same hi) (.trans
      (path_sound B hB i j _ (component_paths (supportMask B) i j h)) (.same (same_symm hj)))

/-- Class properness allows each vertex its own representative in the same
wiggle class. It does not require one simultaneously proper representative. -/
def ProperClass (B : Matrix 4) (p : CyclicOrder) : Prop :=
  ∀ v : Fin 4, ∃ q : CyclicOrder, WiggleEquivalent B p q ∧ ProperVertex B q v

def ProperClassTable (B : Matrix 4) (i : Fin 6) : Prop :=
  ∀ v : Fin 4, ∃ j : Fin 6, component (supportMask B) i=component (supportMask B) j ∧
    ProperVertex B (order j) v
instance (B : Matrix 4) (i : Fin 6) : Decidable (ProperClassTable B i) :=
  inferInstanceAs (Decidable (∀ v : Fin 4, ∃ j : Fin 6, _))

/-- Exact finite test for class properness, with both quantifiers retained. -/
theorem properClass_iff_table (B : Matrix 4) (hB : SkewSymmetric B)
    (p : CyclicOrder) (i : Fin 6) (hi : SameCyclicOrder p (order i)) :
    ProperClass B p ↔ ProperClassTable B i := by
  constructor
  · intro h v
    obtain ⟨q,hq,hv⟩ := h v
    obtain ⟨j,hj⟩ := cyclic_order_exhaustive q
    exact ⟨j,(wiggle_iff_component B hB p q i j hi hj).mp hq,
      (properVertex_cyclic B q (order j) hj v).mp hv⟩
  · intro h v
    obtain ⟨j,hj,hv⟩ := h v
    exact ⟨order j,(wiggle_iff_component B hB p (order j) i j hi (same_refl _)).mpr hj,hv⟩

theorem wiggle_symmetric (B : Matrix 4) (hB : SkewSymmetric B)
    {p q : CyclicOrder} (h : WiggleEquivalent B p q) : WiggleEquivalent B q p := by
  obtain ⟨i,hi⟩ := cyclic_order_exhaustive p
  obtain ⟨j,hj⟩ := cyclic_order_exhaustive q
  exact (wiggle_iff_component B hB q p j i hj hi).mpr
    ((wiggle_iff_component B hB p q i j hi hj).mp h).symm

theorem properClass_wiggle (B : Matrix 4) (hB : SkewSymmetric B)
    {p q : CyclicOrder} (h : WiggleEquivalent B p q) : ProperClass B p ↔ ProperClass B q := by
  constructor
  · intro hp v
    obtain ⟨r,hr,hv⟩ := hp v
    exact ⟨r,.trans (wiggle_symmetric B hB h) hr,hv⟩
  · intro hq v
    obtain ⟨r,hr,hv⟩ := hq v
    exact ⟨r,.trans h hr,hv⟩

/-- A directed unit four-cycle has a proper wiggle class whose four vertices
are proper in different representatives. -/
def separateRepresentatives : Matrix 4 := ofSix (-1) 0 1 (-1) 0 (-1)

theorem separate_representatives_class_proper : ProperClass separateRepresentatives (order 1) := by
  apply (properClass_iff_table _ (ofSix_skew _ _ _ _ _ _) _ 1 (same_refl _)).mpr
  decide

/-- Replacing class properness by simultaneous properness would reject this
actual class. The failure is quantified over every linear order. -/
theorem separate_representatives_no_simultaneous :
    ¬ ∃ q : CyclicOrder, WiggleEquivalent separateRepresentatives (order 1) q ∧
      ∀ v, ProperVertex separateRepresentatives q v := by
  rintro ⟨q,hq,hv⟩
  obtain ⟨j,hj⟩ := cyclic_order_exhaustive q
  have hc := (wiggle_iff_component _ (ofSix_skew _ _ _ _ _ _) (order 1) q 1 j
    (same_refl _) hj).mp hq
  have hn : ∀ j : Fin 6,
      component (supportMask separateRepresentatives) 1=component (supportMask separateRepresentatives) j →
      ¬ (∀ v, ProperVertex separateRepresentatives (order j) v) := by decide
  apply hn j hc
  intro v
  exact (properVertex_cyclic _ q (order j) hj v).mp (hv v)

end QuiverProofs.ProperWiggle
