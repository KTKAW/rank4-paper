import QuiverProofs.ProperOrder

namespace QuiverProofs.ProperWiggle
open ProperOrder Census

def nextPosition (a : Fin 4) : Fin 4 := ⟨(a.val+1)%4, Nat.mod_lt _ (by decide)⟩

def swapPositions (a : Fin 4) : Relabeling 4 :=
  let f := fun i => if i=a then nextPosition a else if i=nextPosition a then a else i
  ⟨f,f,by intro i; exact (show ∀ a i : Fin 4,
      (if (if i=a then nextPosition a else if i=nextPosition a then a else i)=a then nextPosition a
       else if (if i=a then nextPosition a else if i=nextPosition a then a else i)=nextPosition a then a
       else (if i=a then nextPosition a else if i=nextPosition a then a else i))=i from by decide) a i,
    by intro i; exact (show ∀ a i : Fin 4,
      (if (if i=a then nextPosition a else if i=nextPosition a then a else i)=a then nextPosition a
       else if (if i=a then nextPosition a else if i=nextPosition a then a else i)=nextPosition a then a
       else (if i=a then nextPosition a else if i=nextPosition a then a else i))=i from by decide) a i⟩

def swapAdjacent (p : CyclicOrder) (a : Fin 4) : CyclicOrder := p.trans (swapPositions a)

def supportMatrix (mask : Fin 64) : Matrix 4 :=
  ofSix (mask.val%2) (mask.val/2%2) (mask.val/4%2)
    (mask.val/8%2) (mask.val/16%2) (mask.val/32%2)

