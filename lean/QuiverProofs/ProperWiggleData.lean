def route (mask : Fin 64) (i j : Fin 6) : List (Fin 6) := routeData.get ((mask.val*6+i.val)*6+j.val)

def Edge (mask : Fin 64) (i j : Fin 6) : Prop :=
  ∃ a : Fin 4, supportMatrix mask ((order i).toFun a) ((order i).toFun (nextPosition a))=0 ∧ neighbor i a=j
instance (mask : Fin 64) (i j : Fin 6) : Decidable (Edge mask i j) :=
  inferInstanceAs (Decidable (∃ a : Fin 4, _))

def ValidPath (mask : Fin 64) (i : Fin 6) : List (Fin 6) → Fin 6 → Prop
  | [], j => i=j
  | k::ks, j => Edge mask i k ∧ ValidPath mask k ks j

def validPathDecidable (mask : Fin 64) (i : Fin 6) :
    (ks : List (Fin 6)) → (j : Fin 6) → Decidable (ValidPath mask i ks j)
  | [], j => inferInstanceAs (Decidable (i=j))
  | k::ks, j =>
    @instDecidableAnd (Edge mask i k) (ValidPath mask k ks j) inferInstance (validPathDecidable mask k ks j)
instance (mask : Fin 64) (i j : Fin 6) (ks : List (Fin 6)) : Decidable (ValidPath mask i ks j) :=
  validPathDecidable mask i ks j

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem neighbor_correct : ∀ (i : Fin 6) (a : Fin 4),
    SameCyclicOrder (swapAdjacent (order i) a) (order (neighbor i a)) := by decide

theorem permutation_swap_normalization : ∀ (p : Fin 24) (a : Fin 4), ∃ (i : Fin 6) (b : Fin 4),
    SameCyclicOrder (permutation p) (order i) ∧
    (permutation p).toFun a=(order i).toFun b ∧
    (permutation p).toFun (nextPosition a)=(order i).toFun (nextPosition b) ∧
    SameCyclicOrder (swapAdjacent (permutation p) a) (order (neighbor i b)) := by decide

theorem edge_component : ∀ (mask : Fin 64) (i j : Fin 6),
    Edge mask i j → component mask i=component mask j := by decide

theorem component_paths : ∀ (mask : Fin 64) (i j : Fin 6),
    component mask i=component mask j → ValidPath mask i (route mask i j) j := by decide

theorem component_path_lengths : ∀ (mask : Fin 64) (i j : Fin 6),
    (route mask i j).length ≤ 5 := by decide

end QuiverProofs.ProperWiggle
