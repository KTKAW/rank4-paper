private theorem finite_chosen : ∀ code : Fin 729, FiniteChosen code := by
  intro code
  let block : Fin 27 := ⟨code.val/27, by have := code.isLt; omega⟩
  let offset : Fin 27 := ⟨code.val%27, by omega⟩
  have he : chunkCode block offset = code := by
    apply Fin.ext
    simp only [chunkCode, block, offset]
    omega
  rw [←he]
  have hb : block=0 ∨ block=1 ∨ block=2 ∨ block=3 ∨ block=4 ∨ block=5 ∨ block=6 ∨ block=7 ∨ block=8 ∨ block=9 ∨ block=10 ∨ block=11 ∨ block=12 ∨ block=13 ∨ block=14 ∨ block=15 ∨ block=16 ∨ block=17 ∨ block=18 ∨ block=19 ∨ block=20 ∨ block=21 ∨ block=22 ∨ block=23 ∨ block=24 ∨ block=25 ∨ block=26 := by omega
  rcases hb with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · rw [h]
    exact finite_chosen_00 offset
  · rw [h]
    exact finite_chosen_01 offset
  · rw [h]
    exact finite_chosen_02 offset
  · rw [h]
    exact finite_chosen_03 offset
  · rw [h]
    exact finite_chosen_04 offset
  · rw [h]
    exact finite_chosen_05 offset
  · rw [h]
    exact finite_chosen_06 offset
  · rw [h]
    exact finite_chosen_07 offset
  · rw [h]
    exact finite_chosen_08 offset
  · rw [h]
    exact finite_chosen_09 offset
  · rw [h]
    exact finite_chosen_10 offset
  · rw [h]
    exact finite_chosen_11 offset
  · rw [h]
    exact finite_chosen_12 offset
  · rw [h]
    exact finite_chosen_13 offset
  · rw [h]
    exact finite_chosen_14 offset
  · rw [h]
    exact finite_chosen_15 offset
  · rw [h]
    exact finite_chosen_16 offset
  · rw [h]
    exact finite_chosen_17 offset
