private theorem finite_extensions : ∀ code : Fin 729, FiniteExtensions code := by
  intro code a b c d ha k
  exact ⟨selectedIndex code a b c d k, finite_chosen code a b c d ha k⟩

/-- Standard colored triangle/square admissibility constructs each actual
auxiliary extension.  The finite abstraction is transferred by proved sign
equalities, so no exchange-weight bound is present. -/
theorem colorAdmissible_has_extensions (B : Matrix 4) (hB : SkewSymmetric B)
    (green : Colors) (ha : ColorAdmissible B green) (k : Fin 4) :
    ∃ p : CyclicOrder, Compatible B green k p ∧ GreenBeforeRed green p := by
  obtain ⟨code, hcode⟩ := proxy_pattern B hB
  have ha' := (proxy_colorAdmissible B green).mpr ha
  rw [hcode, colors4_exhaustive green] at ha'
  obtain ⟨index, hi, hc⟩ := finite_extensions code
    (green 0) (green 1) (green 2) (green 3) ha' k
  refine ⟨Census.permutation index, ?_, ?_⟩
  · apply (proxy_compatible B green k _).mp
    rw [hcode, colors4_exhaustive green]
    exact hi
  · rw [colors4_exhaustive green]
    exact hc

theorem colorAdmissible_has_certificate (B : Matrix 4) (hB : SkewSymmetric B)
    (green : Colors) (ha : ColorAdmissible B green) :
    ∃ p : CyclicOrder, AuxiliaryCertificate B green p := by
  obtain ⟨p, hp, _⟩ := colorAdmissible_has_extensions B hB green ha 0
  refine ⟨p, ?_⟩
  intro k
  obtain ⟨q, hq, hc⟩ := colorAdmissible_has_extensions B hB green ha k
  exact ⟨q, compatible_orders_wiggle B hB green 0 k p q hp hq, hq, hc⟩

/-- Standard companion parity for the four triangles and three induced
squares.  On rank four these are all chordless simple support cycles. -/
def triangleCompanionAdmissible (B A : Matrix 4) (i j k : Fin 4) : Prop :=
  B i j ≠ 0 → B j k ≠ 0 → B k i ≠ 0 →
    ((decide (0 < A i j) ^^ decide (0 < A j k) ^^ decide (0 < A k i)) = true ↔
      (0 < B i j ∧ 0 < B j k ∧ 0 < B k i) ∨
      (B i j < 0 ∧ B j k < 0 ∧ B k i < 0))

def squareCompanionAdmissible (B A : Matrix 4) (i j k l : Fin 4) : Prop :=
  B i j ≠ 0 → B j k ≠ 0 → B k l ≠ 0 → B l i ≠ 0 →
    B i k = 0 → B j l = 0 →
    ((decide (0 < A i j) ^^ decide (0 < A j k) ^^
      decide (0 < A k l) ^^ decide (0 < A l i)) = true ↔
      (0 < B i j ∧ 0 < B j k ∧ 0 < B k l ∧ 0 < B l i) ∨
      (B i j < 0 ∧ B j k < 0 ∧ B k l < 0 ∧ B l i < 0))

def CompanionAdmissible4 (B A : Matrix 4) : Prop :=
  triangleCompanionAdmissible B A 0 1 2 ∧
  triangleCompanionAdmissible B A 0 1 3 ∧
  triangleCompanionAdmissible B A 0 2 3 ∧
  triangleCompanionAdmissible B A 1 2 3 ∧
  squareCompanionAdmissible B A 0 1 2 3 ∧
  squareCompanionAdmissible B A 0 1 3 2 ∧
  squareCompanionAdmissible B A 0 2 1 3

theorem positiveColorEdge_companion (B A : Matrix 4) (hB : SkewSymmetric B)
    (hA : ∀ i j, A i j = A j i) (green : Colors)
    (hs : ArrowSigns B A green) (i j : Fin 4) (hne : B i j ≠ 0) :
    positiveColorEdge B green i j = decide (0 < A i j) := by
  by_cases hp : 0 < B i j
  · have hn : ¬0 < B j i := by have := hB i j; omega
    simp [positiveColorEdge, hp, hn, hs i j hp]
  · have hn : 0 < B j i := by have := hB i j; omega
    simp [positiveColorEdge, hp, hn, hA i j, hs j i hn]

/-- Actual current companion admissibility and arrow signs supply the color
parities required by the order construction.  There is no path/order premise. -/
theorem companion_colorAdmissible (B A : Matrix 4) (hB : SkewSymmetric B)
    (hA : ∀ i j, A i j = A j i) (green : Colors)
    (hs : ArrowSigns B A green) (ha : CompanionAdmissible4 B A) :
    ColorAdmissible B green := by
  have tri : ∀ i j k, triangleCompanionAdmissible B A i j k →
      triangleColorAdmissible B green i j k := by
    intro i j k h hij hjk hki
    rw [positiveColorEdge_companion B A hB hA green hs i j hij,
      positiveColorEdge_companion B A hB hA green hs j k hjk,
      positiveColorEdge_companion B A hB hA green hs k i hki]
    exact h hij hjk hki
  have square : ∀ i j k l, squareCompanionAdmissible B A i j k l →
      squareColorAdmissible B green i j k l := by
    intro i j k l h hij hjk hkl hli hik hjl
    rw [positiveColorEdge_companion B A hB hA green hs i j hij,
      positiveColorEdge_companion B A hB hA green hs j k hjk,
      positiveColorEdge_companion B A hB hA green hs k l hkl,
      positiveColorEdge_companion B A hB hA green hs l i hli]
    exact h hij hjk hkl hli hik hjl
  exact ⟨tri 0 1 2 ha.1, tri 0 1 3 ha.2.1, tri 0 2 3 ha.2.2.1,
    tri 1 2 3 ha.2.2.2.1, square 0 1 2 3 ha.2.2.2.2.1,
    square 0 1 3 2 ha.2.2.2.2.2.1, square 0 2 1 3 ha.2.2.2.2.2.2⟩

/-- Every unrestricted acyclic skew input satisfies the actual colored
cycle parities with all vertices green. -/
theorem acyclic_allGreen_colorAdmissible (B : Matrix 4) (hB : SkewSymmetric B)
    (hA : Acyclic B) : ColorAdmissible B (fun _ => true) := by
  obtain ⟨rank, hrank⟩ := hA
  have tri : ∀ i j k, triangleColorAdmissible B (fun _ => true) i j k := by
    intro i j k _ _ _
    simp only [positiveColorEdge, Bool.true_eq_false, false_and, and_false,
      false_or, decide_false, Bool.xor_false,
      Bool.false_eq_true, false_iff]
    rintro (⟨hij, hjk, hki⟩ | ⟨hij, hjk, hki⟩)
    · have := hrank i j hij
      have := hrank j k hjk
      have := hrank k i hki
      omega
    · have hji : 0 < B j i := by have := hB i j; omega
      have hkj : 0 < B k j := by have := hB j k; omega
      have hik : 0 < B i k := by have := hB k i; omega
      have := hrank j i hji
      have := hrank k j hkj
      have := hrank i k hik
      omega
  have square : ∀ i j k l, squareColorAdmissible B (fun _ => true) i j k l := by
    intro i j k l _ _ _ _ _ _
    simp only [positiveColorEdge, Bool.true_eq_false, false_and, and_false,
      false_or, decide_false, Bool.xor_false,
      Bool.false_eq_true, false_iff]
    rintro (⟨hij, hjk, hkl, hli⟩ | ⟨hij, hjk, hkl, hli⟩)
    · have := hrank i j hij
      have := hrank j k hjk
      have := hrank k l hkl
      have := hrank l i hli
      omega
    · have hji : 0 < B j i := by have := hB i j; omega
      have hkj : 0 < B k j := by have := hB j k; omega
      have hlk : 0 < B l k := by have := hB k l; omega
      have hil : 0 < B i l := by have := hB l i; omega
      have := hrank j i hji
      have := hrank k j hkj
      have := hrank l k hlk
      have := hrank i l hil
      omega
  exact ⟨tri 0 1 2, tri 0 1 3, tri 0 2 3, tri 1 2 3,
    square 0 1 2 3, square 0 1 3 2, square 0 2 1 3⟩

theorem companion_has_auxiliaryCertificate (B A : Matrix 4)
    (hB : SkewSymmetric B) (hA : QuasiCartanCompanion B A) (green : Colors)
    (hs : ArrowSigns B A green) (ha : CompanionAdmissible4 B A) :
    ∃ p : CyclicOrder, AuxiliaryCertificate B green p :=
  colorAdmissible_has_certificate B hB green
    (companion_colorAdmissible B A hB hA.1 green hs ha)

