private def selectedIndex (code : Fin 729) (a b c d : Bool) (k : Fin 4) : Fin 24 :=
  ⟨((selectedTables.get (code.val / 27)).get ((code.val % 27) * 16 +
    (if a then 1 else 0) + 2*(if b then 1 else 0) +
    4*(if c then 1 else 0) + 8*(if d then 1 else 0)) / 24^k.val) % 24,
    Nat.mod_lt _ (by decide)⟩

private def FiniteChosen (code : Fin 729) : Prop :=
  ∀ a b c d : Bool,
    ColorAdmissible (pattern code) (colors4 a b c d) →
    ∀ k : Fin 4,
      Compatible (pattern code) (colors4 a b c d) k
        (Census.permutation (selectedIndex code a b c d k)) ∧
      GreenBeforeRed (colors4 a b c d)
        (Census.permutation (selectedIndex code a b c d k))

private instance (code : Fin 729) : Decidable (FiniteChosen code) := by
  unfold FiniteChosen
  infer_instance

private def chunkCode (block offset : Fin 27) : Fin 729 :=
  ⟨block.val*27+offset.val, by have := block.isLt; have := offset.isLt; omega⟩

private theorem finite_chosen_00 : ∀ offset : Fin 27,
    FiniteChosen (chunkCode 0 offset) := by decide +kernel

private theorem finite_chosen_01 : ∀ offset : Fin 27,
    FiniteChosen (chunkCode 1 offset) := by decide +kernel

