import QuiverProofs.MAExistenceInitialization
import QuiverProofs.MAExistenceCompanions

/-! Common wiggle classes for actual auxiliary linear extensions.  The colored
matrix below preserves the original zero support; its use therefore covers
arbitrary weights, zero edges, and disconnected supports. -/
namespace QuiverProofs.MAExistenceAuxiliaryOrders
open ProperOrder ProperWiggle ProperMutation ProperObstructionSoundness
open MAExistenceLiterature MAExistenceCoordinator MAExistenceAlternative
open MAExistenceInitialization MAExistenceCompanions
open ProperMutationRepresentativeChoice

/-- Preserve monochromatic arrows and orient every bichromatic support edge
from its green endpoint to its red endpoint. -/
def coloredMatrix (B : Matrix 4) (green : Colors) : Matrix 4 := fun i j =>
  if green i = green j then B i j
  else if green i then (B i j).natAbs else -((B i j).natAbs : Int)

theorem coloredMatrix_skew (B : Matrix 4) (hB : SkewSymmetric B)
    (green : Colors) : SkewSymmetric (coloredMatrix B green) := by
  intro i j
  cases hi : green i <;> cases hj : green j <;>
    simp [coloredMatrix, hi, hj, hB i j]

theorem coloredMatrix_zero (B : Matrix 4) (green : Colors) (i j : Fin 4) :
    coloredMatrix B green i j = 0 ↔ B i j = 0 := by
  cases hi : green i <;> cases hj : green j <;>
    simp [coloredMatrix, hi, hj]

theorem coloredMatrix_arrow_auxiliary (B : Matrix 4) (hB : SkewSymmetric B)
    (green : Colors) (k i j : Fin 4) (h : 0 < coloredMatrix B green i j) :
    AuxiliaryArrow B green k i j := by
  cases hi : green i <;> cases hj : green j
  · exact Or.inl ⟨by simpa [coloredMatrix, hi, hj] using h, by simp [hi, hj]⟩
  · have hn : 0 ≤ ((B i j).natAbs : Int) := by omega
    simp [coloredMatrix, hi, hj] at h
    omega
  · have hn : B i j ≠ 0 := by
      intro hz
      simp [coloredMatrix, hi, hj, hz] at h
    by_cases hp : 0 < B i j
    · exact Or.inl ⟨hp, by simp [hi, hj]⟩
    · have hr : 0 < B j i := by have := hB i j; omega
      exact Or.inr (Or.inl ⟨hr, hj, hi⟩)
  · exact Or.inl ⟨by simpa [coloredMatrix, hi, hj] using h, by simp [hi, hj]⟩

theorem increasing_arrows_topological (B : Matrix 4) (hB : SkewSymmetric B)
    (p : CyclicOrder)
    (h : ∀ i j, 0 < B i j → p.invFun i < p.invFun j) :
    Topological B p := by
  have upper : ∀ a b : Fin 4, a < b → 0 ≤ B (p.toFun a) (p.toFun b) := by
    intro a b hab
    by_cases hn : 0 ≤ B (p.toFun a) (p.toFun b)
    · exact hn
    have hr : 0 < B (p.toFun b) (p.toFun a) := by
      have := hB (p.toFun a) (p.toFun b)
      omega
    have hh := h _ _ hr
    simp only [p.left_inv] at hh
    omega
  exact ⟨upper 0 1 (by decide), upper 0 2 (by decide),
    upper 0 3 (by decide), upper 1 2 (by decide),
    upper 1 3 (by decide), upper 2 3 (by decide)⟩

theorem compatible_coloredMatrix_topological (B : Matrix 4)
    (hB : SkewSymmetric B) (green : Colors) (k : Fin 4)
    (p : CyclicOrder) (hp : Compatible B green k p) :
    Topological (coloredMatrix B green) p := by
  apply increasing_arrows_topological _ (coloredMatrix_skew B hB green) p
  intro i j hij
  exact hp i j (coloredMatrix_arrow_auxiliary B hB green k i j hij)

/-- Actual auxiliary extensions for different pivots all belong to one
wiggle class.  No companion, admissibility, or color-block assumption is used. -/
theorem compatible_orders_wiggle (B : Matrix 4) (hB : SkewSymmetric B)
    (green : Colors) (k l : Fin 4) (p q : CyclicOrder)
    (hp : Compatible B green k p) (hq : Compatible B green l q) :
    WiggleEquivalent B p q := by
  apply wiggle_zero_transfer (coloredMatrix B green) B
    (fun i j hz => (coloredMatrix_zero B green i j).mp hz)
  exact topological_orders_wiggle _ (coloredMatrix_skew B hB green) p q
    (compatible_coloredMatrix_topological B hB green k p hp)
    (compatible_coloredMatrix_topological B hB green l q hq)

/-- The positive companion sign prescribed by the arrow-color rule.  The
definition is symmetric for skew matrices and ignores magnitudes. -/
def positiveColorEdge (B : Matrix 4) (green : Colors) (i j : Fin 4) : Bool :=
  decide ((0 < B i j ∧ green i = false ∧ green j = true) ∨
    (0 < B j i ∧ green j = false ∧ green i = true))

def triangleColorAdmissible (B : Matrix 4) (green : Colors)
    (i j k : Fin 4) : Prop :=
  B i j ≠ 0 → B j k ≠ 0 → B k i ≠ 0 →
    ((positiveColorEdge B green i j ^^ positiveColorEdge B green j k ^^
      positiveColorEdge B green k i) = true ↔
      (0 < B i j ∧ 0 < B j k ∧ 0 < B k i) ∨
      (B i j < 0 ∧ B j k < 0 ∧ B k i < 0))

def squareColorAdmissible (B : Matrix 4) (green : Colors)
    (i j k l : Fin 4) : Prop :=
  B i j ≠ 0 → B j k ≠ 0 → B k l ≠ 0 → B l i ≠ 0 →
    B i k = 0 → B j l = 0 →
    ((positiveColorEdge B green i j ^^ positiveColorEdge B green j k ^^
      positiveColorEdge B green k l ^^ positiveColorEdge B green l i) = true ↔
      (0 < B i j ∧ 0 < B j k ∧ 0 < B k l ∧ 0 < B l i) ∨
      (B i j < 0 ∧ B j k < 0 ∧ B k l < 0 ∧ B l i < 0))

/-- The four triangles and three possible chordless squares on four vertices.
This is the usual companion admissibility parity after substituting the actual
arrow-color sign rule, with no order-existence premise. -/
def ColorAdmissible (B : Matrix 4) (green : Colors) : Prop :=
  triangleColorAdmissible B green 0 1 2 ∧
  triangleColorAdmissible B green 0 1 3 ∧
  triangleColorAdmissible B green 0 2 3 ∧
  triangleColorAdmissible B green 1 2 3 ∧
  squareColorAdmissible B green 0 1 2 3 ∧
  squareColorAdmissible B green 0 1 3 2 ∧
  squareColorAdmissible B green 0 2 1 3

private theorem signProxy_pos (x : Int) : 0 < signProxy x ↔ 0 < x := by
  unfold signProxy
  split <;> (try split) <;> omega

private theorem signProxy_neg_iff (x : Int) : signProxy x < 0 ↔ x < 0 := by
  unfold signProxy
  split <;> (try split) <;> omega

theorem proxy_colorAdmissible (B : Matrix 4) (green : Colors) :
    ColorAdmissible (proxyMatrix B) green ↔ ColorAdmissible B green := by
  simp only [ColorAdmissible, triangleColorAdmissible, squareColorAdmissible,
    positiveColorEdge, proxyMatrix, signProxy_pos, signProxy_neg_iff, ne_eq, signProxy_zero]

theorem proxy_compatible (B : Matrix 4) (green : Colors)
    (k : Fin 4) (p : CyclicOrder) :
    Compatible (proxyMatrix B) green k p ↔ Compatible B green k p := by
  simp only [Compatible, AuxiliaryArrow, proxyMatrix, signProxy_pos]

private def colors4 (a b c d : Bool) : Colors := fun i =>
  match i.val with | 0 => a | 1 => b | 2 => c | _ => d

private theorem colors4_exhaustive (green : Colors) :
    green = colors4 (green 0) (green 1) (green 2) (green 3) := by
  funext i
  have hi : i=0 ∨ i=1 ∨ i=2 ∨ i=3 := by omega
  rcases hi with rfl | rfl | rfl | rfl <;> rfl

private instance (B : Matrix 4) (green : Colors) (i j k : Fin 4) :
    Decidable (triangleColorAdmissible B green i j k) := by
  unfold triangleColorAdmissible
  infer_instance

private instance (B : Matrix 4) (green : Colors) (i j k l : Fin 4) :
    Decidable (squareColorAdmissible B green i j k l) := by
  unfold squareColorAdmissible
  infer_instance

private instance (B : Matrix 4) (green : Colors) : Decidable (ColorAdmissible B green) := by
  unfold ColorAdmissible
  infer_instance

private instance (B : Matrix 4) (green : Colors) (k : Fin 4) (p : CyclicOrder) :
    Decidable (Compatible B green k p) := by
  unfold Compatible AuxiliaryArrow
  infer_instance

private instance (green : Colors) (p : CyclicOrder) :
    Decidable (GreenBeforeRed green p) := by
  unfold GreenBeforeRed
  infer_instance

private def FiniteExtensions (code : Fin 729) : Prop :=
  ∀ a b c d : Bool,
    ColorAdmissible (pattern code) (colors4 a b c d) →
    ∀ k : Fin 4, ∃ index : Fin 24,
      Compatible (pattern code) (colors4 a b c d) k (Census.permutation index) ∧
      GreenBeforeRed (colors4 a b c d) (Census.permutation index)

private instance (code : Fin 729) : Decidable (FiniteExtensions code) := by
  unfold FiniteExtensions
  infer_instance


