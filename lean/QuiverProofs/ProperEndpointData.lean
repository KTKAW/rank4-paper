def certificate (code : Fin 729) (i : Fin 6) : Certificate := certificateData.get (code.val*6+i.val)

def Valid (code : Fin 729) (i : Fin 6) : Certificate → Prop
  | .cyclic => ¬∃ t : Fin 24, Topological (pattern code) (permutation t)
  | .improper => ¬ProperClassTable (pattern code) i
  | .topological t => Topological (pattern code) (permutation t) ∧
      component (supportMask (pattern code)) i = component (supportMask (pattern code)) (canonicalIndex t)
  | .bad k j c =>
      component (supportMask (pattern code)) i = component (supportMask (pattern code)) (canonicalIndex (firstIndex k j)) ∧
      Cut (pattern code) (firstOrder k j) c ∧
      ¬ProperClassTable (mutate (pattern code) k) (resultIndex k j c)
instance (code : Fin 729) (i : Fin 6) (w : Certificate) : Decidable (Valid code i w) := by
  cases w <;> unfold Valid <;> infer_instance

def chunkCode (block offset : Fin 27) : Fin 729 := ⟨block.val*27+offset.val,by omega⟩
def block (code : Fin 729) : Fin 27 := ⟨code.val/27,by omega⟩
def offset (code : Fin 729) : Fin 27 := ⟨code.val%27,by omega⟩
theorem chunkCode_correct (code : Fin 729) : chunkCode (block code) (offset code)=code := by
  apply Fin.ext; simp only [chunkCode,block,offset]; omega
end QuiverProofs.ProperEndpointData
